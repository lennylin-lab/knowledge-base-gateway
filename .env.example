# Local development configuration. Copy this file to .env and adjust values.
# Do not commit real provider credentials or API keys.
#
# Every assignment below is commented out: the gateway boots with zero
# configuration (section 1), so uncomment only what you want to change.

# ---------------------------------------------------------------------------
# 1. Zero-config development (fake provider)
# ---------------------------------------------------------------------------
#
# No variables are required: with the default fake provider, no
# GATEWAY_DATABASE_URL, and neither GATEWAY_API_KEYS nor GATEWAY_MODELS set,
# the gateway injects documented development defaults — subject "dev", API
# key sk-dev-local, model gpt-4o-mini — and `go run ./cmd/gateway` just
# works:
#
#   curl -s localhost:8080/v1/chat/completions \
#     -H 'Authorization: Bearer sk-dev-local' \
#     -H 'Content-Type: application/json' \
#     -d '{"model":"gpt-4o-mini","messages":[{"role":"user","content":"hi"}]}'
#
# Setting either GATEWAY_API_KEYS or GATEWAY_MODELS explicitly opts out of
# the injection: explicit configuration must then be complete (both lists),
# otherwise startup fails with "at least one key/model is required".
#
# Explicit development example (what the injection spares you from typing):
#GATEWAY_ADDR=:8080
#GATEWAY_PROVIDER=fake
#GATEWAY_API_KEYS="key-1:tenant-a:sk-dev-internal-key"
#GATEWAY_MODELS="gpt-4o-mini:fake:gpt-4o-mini"

# ---------------------------------------------------------------------------
# 2. Mode switches
# ---------------------------------------------------------------------------
#
# GATEWAY_DATABASE_URL is the configuration-mode boundary: set it to enable
# PostgreSQL persistence (keys/catalog/routes/policies/audit); leave unset
# for local development mode.
#GATEWAY_DATABASE_URL=postgres://user:pass@localhost:5432/gateway
#
# GATEWAY_LIMITS_MODE=redis (multi-instance deployments) also needs a Redis
# address; "local" (the default) is development-only.
#GATEWAY_LIMITS_MODE=local
#GATEWAY_REDIS_ADDR=127.0.0.1:6379
#
# V1.2: management API (models, providers, policies, audit, usage). The
# listener must stay on an internal network. An empty token leaves the admin
# API off in development mode (in database mode it also runs once scoped
# admin credentials exist).
#GATEWAY_ADMIN_TOKEN=
#GATEWAY_ADMIN_ADDR=:8081

# ---------------------------------------------------------------------------
# 3. Docker Compose interpolation
# ---------------------------------------------------------------------------
#
# docker-compose.yml interpolates these from the root .env; defaults shown
# match the compose file. Host ports are loopback-bound and chosen not to
# collide with a co-existing knowledge-base-server stack (5432/6379).
#GATEWAY_HOST_PORT=8091
#GATEWAY_ADMIN_HOST_PORT=8092
#POSTGRES_HOST_PORT=5433
#REDIS_HOST_PORT=6381
#POSTGRES_USER=gateway
#POSTGRES_PASSWORD=gateway-local-throwaway  # deterministic throwaway; override for anything non-disposable
#POSTGRES_DB=gateway
#GATEWAY_IMAGE=kb-gateway:local
# Compose widens the 30s code default on purpose: reasoning models
# legitimately pause between stream frames while thinking (gpt-5.5 pauses of
# 30-45s were observed mid-tool-call) and the default stall window
# truncates those runs.
#GATEWAY_STREAM_STALL_TIMEOUT=2m

# ---------------------------------------------------------------------------
# 4. Operational knobs (code defaults are sane; override on demand)
# ---------------------------------------------------------------------------
#
# V1.2: Responses protocol endpoint and model discovery. Set to "false" to
# disable /v1/responses independently of Chat Completions (rollback switch).
#GATEWAY_RESPONSES_ENABLED=true
#
# V1.3: Embeddings protocol endpoint (OpenAI-compatible /v1/embeddings). Set
# to "false" to disable it independently (rollback switch). Per-model gates
# live in the catalog capability matrix (embeddings + embedding_dim).
#GATEWAY_EMBEDDINGS_ENABLED=true
#
# V1.3: development-mode subject default models. Requests omitting `model`
# backfill the subject's matching slot (chat/responses use the chat slot,
# embeddings the embedding slot). Database mode ignores this list;
# access_policies.default_model / default_embedding_model are authoritative.
#GATEWAY_DEFAULT_MODELS="tenant-a:gpt-4o-mini"
#
# Timeouts, retries, and rate limiting. An explicit 0 for the two stream
# timeouts disables that check (rollback switch).
#GATEWAY_STREAM_STALL_TIMEOUT=30s
#GATEWAY_STREAM_TOTAL_TIMEOUT=10m
#GATEWAY_STREAM_MAX_RETRIES=10
#GATEWAY_MAX_RETRIES=2
#GATEWAY_RATE_PER_MINUTE=120
#
# V1.4 background Responses jobs: opt-in and database-mode only.
#GATEWAY_ASYNC_ENABLED=false
#
# V1.4 monetary budget enforcement: opt-in; ledger capture is always on in
# database mode, so enforcement can be rolled back without losing evidence.
#GATEWAY_BUDGETS_ENABLED=false
#
# V1.4 data lifecycle: default on, inert until retention_policies rows exist.
#GATEWAY_LIFECYCLE_ENABLED=true
#
# V1.4 observability: OTLP trace export, default off. NOTE: under Compose,
# "localhost:4318" inside the container is the gateway itself — point
# GATEWAY_OTLP_ENDPOINT at the collector's in-network address (or
# host.docker.internal:4318 for a host-side collector).
#GATEWAY_OTLP_ENABLED=false
#GATEWAY_OTLP_ENDPOINT=localhost:4318
#GATEWAY_OTLP_INSECURE=false

# ---------------------------------------------------------------------------
# 5. Per-provider credentials
# ---------------------------------------------------------------------------
#
# To use an OpenAI-compatible provider instead of the fake default:
# GATEWAY_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# GATEWAY_MODELS="gpt-4o-mini:openai:gpt-4o-mini"
#
# Anthropic is symmetric:
# GATEWAY_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# GATEWAY_MODELS="claude-sonnet-4-5:anthropic:claude-sonnet-4-5"
#
# Docker Compose (database mode): providers live in PostgreSQL; base URLs are
# stored in the providers table. Only API keys are injected here — list them
# in docker-compose.yml gateway.environment. Per-provider names match the DB row:
#   openai-primary -> OPENAI_API_KEY__OPENAI_PRIMARY (fallback: OPENAI_API_KEY)
#   openai-embed   -> OPENAI_API_KEY__OPENAI_EMBED   (fallback: OPENAI_API_KEY)
# The same pattern covers anthropic rows (ANTHROPIC_API_KEY__<PROVIDER_NAME>).
# OPENAI_API_KEY=sk-fallback-or-shared-key
# OPENAI_API_KEY__OPENAI_PRIMARY=sk-chat-upstream-key
# OPENAI_API_KEY__OPENAI_EMBED=sk-embed-upstream-key
#
# After `docker compose up -d`, run `./scripts/bootstrap-openai.sh` to import
# gpt-5.5 + qwen3-embedding into PostgreSQL. Optional catalog overrides:
# GATEWAY_OPENAI_CHAT_BASE_URL, GATEWAY_OPENAI_EMBED_BASE_URL,
# GATEWAY_OPENAI_CHAT_MODEL, GATEWAY_OPENAI_EMBED_MODEL
