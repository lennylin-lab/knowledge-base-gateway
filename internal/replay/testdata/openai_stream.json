{
  "name": "openai/stream-text",
  "provider": "openai",
  "upstream": {
    "status": 200,
    "headers": {"Content-Type": "text/event-stream"},
    "body": "data: {\"id\":\"c\",\"choices\":[{\"delta\":{\"content\":\"he\"}}]}\n\ndata: {\"id\":\"c\",\"choices\":[{\"delta\":{\"content\":\"y\"}}]}\n\ndata: {\"id\":\"c\",\"choices\":[{\"delta\":{},\"finish_reason\":\"stop\"}]}\n\ndata: [DONE]\n\n"
  },
  "request": {
    "upstream_model": "up-model",
    "input": [{"role": "user", "text": "hello"}],
    "stream": true
  },
  "expect": {
    "events": ["created", "text_delta", "text_delta", "text_done", "completed"],
    "stream_text": "hey"
  }
}
